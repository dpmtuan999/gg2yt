# Google Drive folder ID (from the folder URL)
# e.g. https://drive.google.com/drive/folders/ABC123xyz → FOLDER_ID=ABC123xyz
GOOGLE_DRIVE_FOLDER_ID=

# Polling interval in milliseconds (default: 5 minutes)
POLL_INTERVAL_MS=300000

# Path to OAuth2 credentials file
CREDENTIALS_PATH=./credentials/credentials.json

# Token account GOOGLE DRIVE (folder sở hữu) — có thể KHÁC account YouTube
DRIVE_TOKEN_PATH=./data/drive-token.json

# Token account YOUTUBE (channel nhận video) — có thể KHÁC account Drive
YOUTUBE_TOKEN_PATH=./data/youtube-token.json

# Path to store processed file state
STATE_PATH=./data/processed.json

# YouTube video privacy status: unlisted | private | public
YOUTUBE_PRIVACY_STATUS=unlisted

# YouTube video default description (optional)
YOUTUBE_DEFAULT_DESCRIPTION=

# Port for OAuth2 callback server
OAUTH_PORT=3000

# Lần chạy đầu tiên (chưa có state): true = đánh dấu video hiện có là đã xử lý
# (chỉ upload file MỚI thêm sau này) | false = upload toàn bộ video trong folder
SKIP_EXISTING_ON_FIRST_RUN=true
